#!/bin/bash

# Yautja mode for Omarchy: vision modes, cloak, hunt, trophy wall, self-destruct.
#
#   yautja vision [next|off|thermal|em|tracking|status]
#   yautja cloak [all-off]
#   yautja hunt [--no-honour]
#   yautja trophies [notify|clear|json]
#   yautja self-destruct [abort]
#
# Set SOUND=0 in ~/.config/yautja/config to hunt silently.
# Set YAUTJA_DRY_RUN=1 to run self-destruct without shutting down.

set -uo pipefail

# The plugin checkout this script lives in, even when run through a symlink.
ROOT=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")

STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
STATE_DIR=$STATE_HOME/yautja
STATE=$STATE_DIR/state.json
KILL_LOG=$STATE_DIR/kills.jsonl
RUN_DIR=${XDG_RUNTIME_DIR:-/tmp}/yautja
SHADER_DIR=$ROOT/shaders
VISION_TOGGLE=$STATE_HOME/omarchy/toggles/hypr/yautja-vision.lua
SOUND_FILE=$ROOT/sounds/clicks.ogg
CONFIG=$HOME/.config/yautja/config

VISION_MODES=(off thermal em tracking)
CLOAK_TAG=yautja-cloak
LOCK_TAG=yautja-lock
LOCK_SECONDS=6
UNARMED_KB=$((100 * 1024))   # below this the prey is spared
WORTHY_KB=$((1024 * 1024))   # at or above this the kill earns a skull

SOUND=1
[[ -f $CONFIG ]] && source "$CONFIG"

mkdir -p "$STATE_DIR" "$RUN_DIR"

notify() {
  local glyph=$1 headline=$2 description=${3:-}
  omarchy-notification-send -g "$glyph" -t 3500 "$headline" "$description" >/dev/null 2>&1 || true
}

clicks() {
  [[ $SOUND == 1 && -f $SOUND_FILE ]] || return 0
  (pw-play --volume 0.3 "$SOUND_FILE" >/dev/null 2>&1 &)
}

boot_id() {
  cat /proc/sys/kernel/random/boot_id 2>/dev/null
}

read_state() {
  if [[ -s $STATE ]] && jq -e . "$STATE" >/dev/null 2>&1; then
    cat "$STATE"
  else
    echo '{"vision":"off","trophies":[]}'
  fi
}

# Written in place, not renamed, so the bar widget's file watch keeps firing.
write_state() {
  local content
  content=$(cat)
  printf '%s\n' "$content" >"$STATE"
}

human_kb() {
  awk -v kb="$1" 'BEGIN { if (kb >= 1048576) printf "%.1f GB", kb / 1048576; else printf "%d MB", kb / 1024 }'
}

tree_pids() {
  local pid=$1 child
  echo "$pid"
  for child in $(pgrep -P "$pid" 2>/dev/null); do
    tree_pids "$child"
  done
}

tree_rss_kb() {
  local pids
  pids=$(tree_pids "$1" | paste -sd,)
  ps -o rss= -p "$pids" 2>/dev/null | awk '{ sum += $1 } END { print sum + 0 }'
}

window_dispatch() {
  hyprctl dispatch "$1" >/dev/null 2>&1
}

# --- Vision ------------------------------------------------------------------

vision_current() {
  read_state | jq -r '.vision // "off"'
}

vision_set() {
  local mode=$1 shader=""

  if [[ $mode != off ]]; then
    shader=$SHADER_DIR/$mode.frag
    if [[ ! -f $shader ]]; then
      echo "Unknown vision mode: $mode" >&2
      exit 1
    fi
  fi

  hyprctl eval "hl.config({ decoration = { screen_shader = '$shader' } })" >/dev/null

  # The toggle file re-applies the mode when Hyprland reloads its config.
  if [[ $mode == off ]]; then
    rm -f "$VISION_TOGGLE"
  else
    mkdir -p "$(dirname "$VISION_TOGGLE")"
    printf 'hl.config({ decoration = { screen_shader = "%s" } })\n' "$shader" >"$VISION_TOGGLE"
  fi

  read_state | jq --arg mode "$mode" '.vision = $mode' | write_state
  clicks
}

vision() {
  local action=${1:-next} current index i

  case $action in
    status)
      vision_current
      ;;
    next)
      current=$(vision_current)
      index=0
      for i in "${!VISION_MODES[@]}"; do
        [[ ${VISION_MODES[$i]} == "$current" ]] && index=$i
      done
      vision_set "${VISION_MODES[$(((index + 1) % ${#VISION_MODES[@]}))]}"
      ;;
    *)
      vision_set "$action"
      ;;
  esac
}

# --- Cloak -------------------------------------------------------------------

cloak() {
  local window address cloaked

  if [[ ${1:-} == all-off ]]; then
    hyprctl clients -j | jq -r --arg tag "$CLOAK_TAG" '.[] | select(.tags | index($tag)) | .address' |
      while read -r address; do
        window_dispatch "hl.dsp.window.tag({ tag = '-$CLOAK_TAG', window = 'address:$address' })"
      done
    return
  fi

  window=$(hyprctl activewindow -j)
  address=$(jq -r '.address // empty' <<<"$window")
  [[ -n $address ]] || exit 0

  cloaked=$(jq -r --arg tag "$CLOAK_TAG" '.tags | index($tag) != null' <<<"$window")
  if [[ $cloaked == true ]]; then
    window_dispatch "hl.dsp.window.tag({ tag = '-$CLOAK_TAG', window = 'address:$address' })"
  else
    window_dispatch "hl.dsp.window.tag({ tag = '+$CLOAK_TAG', window = 'address:$address' })"
  fi
  clicks
}

# --- Hunt --------------------------------------------------------------------

release_lock() {
  local address=$1
  window_dispatch "hl.dsp.window.tag({ tag = '-$LOCK_TAG', window = 'address:$address' })"
  rm -f "$RUN_DIR/lock"
}

record_kill() {
  local class=$1 title=$2 pid=$3 rss=$4 worthy=$5 entry

  entry=$(jq -cn --arg class "$class" --arg title "$title" --arg boot "$(boot_id)" \
    --argjson pid "$pid" --argjson rss "$rss" --argjson worthy "$worthy" --argjson at "$(date +%s)" \
    '{class: $class, title: $title, pid: $pid, rss_kb: $rss, worthy: $worthy, boot: $boot, at: $at}')

  echo "$entry" >>"$KILL_LOG"
  read_state | jq --argjson entry "$entry" --arg boot "$(boot_id)" \
    '.trophies = ([.trophies[]? | select(.boot == $boot)] + [$entry])' | write_state
}

hunt() {
  local honour=1 window address pid class title rss mass locked_address locked_at now

  [[ ${1:-} == --no-honour ]] && honour=0

  window=$(hyprctl activewindow -j)
  address=$(jq -r '.address // empty' <<<"$window")
  if [[ -z $address ]]; then
    notify "󰓾" "No prey in sight"
    exit 0
  fi

  pid=$(jq -r '.pid' <<<"$window")
  class=$(jq -r '.class' <<<"$window")
  title=$(jq -r '.title' <<<"$window")

  if (( pid <= 1 )) || [[ $class == org.quickshell ]]; then
    notify "󰓾" "Not prey" "$class cannot be hunted"
    exit 0
  fi

  rss=$(tree_rss_kb "$pid")
  mass=$(human_kb "$rss")
  now=$(date +%s)

  locked_address=""
  locked_at=0
  [[ -f $RUN_DIR/lock ]] && read -r locked_address locked_at <"$RUN_DIR/lock"

  # First press locks on. A second press on the same window within the lock
  # window fires.
  if [[ $locked_address != "$address" ]] || (( now - locked_at > LOCK_SECONDS )); then
    [[ -n $locked_address ]] && release_lock "$locked_address"
    echo "$address $now" >"$RUN_DIR/lock"
    window_dispatch "hl.dsp.window.tag({ tag = '+$LOCK_TAG', window = 'address:$address' })"
    notify "󰓾" "Target locked: $class" "$mass. Fire again within ${LOCK_SECONDS}s to take it."
    clicks
    (
      sleep "$LOCK_SECONDS"
      if [[ -f $RUN_DIR/lock ]] && [[ $(cut -d' ' -f1 "$RUN_DIR/lock") == "$address" ]]; then
        release_lock "$address"
      fi
    ) >/dev/null 2>&1 &
    disown
    exit 0
  fi

  release_lock "$address"

  if (( honour == 1 && rss < UNARMED_KB )); then
    notify "󰒲" "No sport" "$class is unarmed ($mass). Spared."
    exit 0
  fi

  if ! kill -KILL "$pid" 2>/dev/null; then
    notify "󰓾" "The prey escaped" "Could not kill $class (pid $pid)"
    exit 1
  fi

  if (( rss >= WORTHY_KB )); then
    record_kill "$class" "$title" "$pid" "$rss" true
    notify "󰚌" "Trophy taken: $class" "$mass"
  else
    record_kill "$class" "$title" "$pid" "$rss" false
    notify "󰓾" "Kill: $class" "$mass. Too small for the wall."
  fi
}

# --- Trophies ----------------------------------------------------------------

trophies() {
  local boot lines
  boot=$(boot_id)

  case ${1:-list} in
    json)
      read_state | jq --arg boot "$boot" '[.trophies[]? | select(.boot == $boot)]'
      ;;
    clear)
      read_state | jq '.trophies = []' | write_state
      ;;
    notify)
      lines=$(read_state | jq -r --arg boot "$boot" '
        [.trophies[]? | select(.boot == $boot)]
        | if length == 0 then "The wall is bare."
          else map((if .worthy then "󰚌 " else "· " end) + .class + "  "
            + (if .rss_kb >= 1048576 then ((.rss_kb / 104857.6 | round) / 10 | tostring) + " GB"
               else ((.rss_kb / 1024 | floor) | tostring) + " MB" end)) | join("\n")
          end')
      omarchy-notification-send -g "󰚌" -t 8000 "Trophy wall" "$lines" >/dev/null 2>&1 || true
      ;;
    *)
      read_state | jq -r --arg boot "$boot" '
        .trophies[]? | select(.boot == $boot)
        | [(.at | strflocaltime("%H:%M:%S")), .class, ((.rss_kb / 1024 | floor | tostring) + " MB"), (if .worthy then "trophy" else "kill" end)]
        | @tsv'
      ;;
  esac
}

# --- Self-destruct -----------------------------------------------------------

self_destruct() {
  local pidfile=$RUN_DIR/destruct.pid idfile=$RUN_DIR/destruct.id
  local glyphs=("╬╬" "╠╣" "╦╩" "╬┤" "├╬" "╩╣" "╠╦" "┤╩" "╦├" "╣╬")

  if [[ -f $pidfile ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    kill "$(cat "$pidfile")" 2>/dev/null
    rm -f "$pidfile"
    omarchy-notification-send -g "󰚑" -t 4000 -r "$(cat "$idfile" 2>/dev/null || echo 0)" \
      "Self-destruct aborted" >/dev/null 2>&1 || true
    exit 0
  fi

  [[ ${1:-} == abort ]] && exit 0

  (
    id=0
    for ((i = 10; i >= 1; i--)); do
      id=$(omarchy-notification-send -g "󰚑" -u critical -t 1500 -r "$id" -p \
        "${glyphs[$((i - 1))]} ${glyphs[$(((i * 3) % 10))]} ${glyphs[$(((i * 7) % 10))]}" \
        "Self-destruct in $i. Run it again to abort." 2>/dev/null || echo 0)
      echo "$id" >"$idfile"
      sleep 1
    done
    rm -f "$pidfile"
    if [[ -n ${YAUTJA_DRY_RUN:-} ]]; then
      omarchy-notification-send -g "󰚑" -t 4000 -r "$id" "Boom" "Dry run, nothing was shut down." >/dev/null 2>&1
    else
      omarchy system shutdown
    fi
  ) >/dev/null 2>&1 &
  echo $! >"$pidfile"
  disown
  clicks
}

case ${1:-} in
  vision) shift; vision "$@" ;;
  cloak) shift; cloak "$@" ;;
  hunt) shift; hunt "$@" ;;
  trophies) shift; trophies "$@" ;;
  self-destruct) shift; self_destruct "$@" ;;
  *)
    sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
